DATABASE_URL=postgresql://payload:payload@127.0.0.1:5432/global_academy
# On Vercel (or any serverless host), point this at a TRANSACTION-mode pooler,
# not a session-mode one — e.g. Supabase's Supavisor pooler on port 6543
# (Project Settings > Database > Connection string > "Transaction" mode),
# not the "Session" mode pooler on port 5432. Session mode holds one Postgres
# connection per serverless instance for the instance's whole lifetime and
# runs out of connections ("max clients reached in session mode") under any
# real concurrency; transaction mode shares a small pool of real connections
# across many short-lived serverless requests.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Filled in once the jobs-board payment flow (Task 5) is wired up:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
